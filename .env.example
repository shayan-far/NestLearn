# Copy to .env (which is git-ignored) and fill in. Real environment variables override this file.

# LLM for alternative explanations, aha recaps and rewrite suggestions.
# Get a key at https://aistudio.google.com/apikey . Leave empty to run with fallback text only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# LLM_PROVIDER=none        # force fallbacks even if a key is set
# LLM_TIMEOUT_S=12

# EEG_SOURCE=sim           # or brainflow
# CALIB_SECONDS=10
# LOG_BUDGET_BYTES=2000000 # NestTrace per-session budget
